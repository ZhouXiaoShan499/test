/**app.wxss 全局样式 —— 风格B：效率笔记风（墨蓝 + 米白）**/

page {
  /* 主色：墨蓝 */
  --ink: #1F3A5F;
  --ink-light: #3C5A80;
  /* 辅助色：暖橙（仅用于强调） */
  --accent: #C97B4A;
  /* 背景：暖白 / 米白 */
  --bg: #F7F4EE;
  --card: #FFFDF8;
  --line: #E6E0D6;
  --text: #2B2B2B;
  --text-sub: #7A7A7A;
  --text-weak: #A8A8A8;

  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* 卡片：少阴影，重分割线 */
.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin: 36rpx 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title .more {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-weak);
}

/* 标签胶囊 */
.tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: #EDF1F6;
  color: var(--ink-light);
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 主按钮 */
.btn-primary {
  background: var(--ink);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* 次要按钮 */
.btn-ghost {
  background: transparent;
  color: var(--ink);
  border: 1rpx solid var(--ink);
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-weak);
  font-size: 26rpx;
}

.empty .empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* 文字省略 */
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ellipsis-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
