/* pages/index/index.wxss */

/* 顶部栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}

.campus-switch {
  display: flex;
  align-items: center;
}

.campus-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.campus-arrow {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-left: 8rpx;
}

.topbar-right {
  display: flex;
  align-items: center;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-left: 16rpx;
}

/* 主卡片：今日打卡 */
.hero-card {
  background: var(--ink);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #FFFFFF;
}

.hero-label {
  font-size: 24rpx;
  opacity: 0.7;
  letter-spacing: 2rpx;
}

.hero-status {
  font-size: 34rpx;
  font-weight: 700;
  margin: 10rpx 0 6rpx;
}

.hero-streak {
  font-size: 24rpx;
  opacity: 0.8;
}

.streak-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #F2C48D;
  margin: 0 4rpx;
}

.hero-btn {
  background: #FFFFFF;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.hero-btn.done {
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
}

/* 两列小卡片 */
.two-col {
  display: flex;
  margin-top: 24rpx;
}

.mini-card {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.mini-card:first-child {
  margin-right: 20rpx;
}

.mini-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.mini-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.mini-sub {
  font-size: 22rpx;
  color: var(--text-weak);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 快捷入口 */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 12rpx 0;
}

.quick-item {
  width: 20%;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-emoji {
  font-size: 40rpx;
  line-height: 1.2;
}

.quick-name {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

/* 校园动态 */
.feed-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.feed-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.feed-row:first-child {
  padding-top: 0;
}

.feed-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  margin: 16rpx 18rpx 0 0;
  flex-shrink: 0;
}

.feed-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.feed-meta {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}

/* 热门笔记 */
.note-row {
  margin-bottom: 20rpx;
}

.note-row-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.note-row-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  margin: 10rpx 0 14rpx;
}

.note-row-foot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.note-row-author {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-left: auto;
}

/* 排行榜 */
.rank-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #EDF1F6;
  color: var(--text-sub);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.rank-no.top {
  background: var(--ink);
  color: #FFFFFF;
  font-weight: 700;
}

.rank-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.rank-count {
  font-size: 24rpx;
  color: var(--text-sub);
}
