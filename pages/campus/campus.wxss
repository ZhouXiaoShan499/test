/* pages/campus/campus.wxss */

/* 顶部插画区 */
.campus-hero {
  position: relative;
  background: var(--ink);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  color: #FFFFFF;
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  right: 20rpx;
  bottom: -10rpx;
  font-size: 160rpx;
  opacity: 0.16;
  line-height: 1;
}

.hero-campus {
  display: flex;
  align-items: center;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-arrow {
  font-size: 24rpx;
  margin-left: 10rpx;
  opacity: 0.8;
}

.hero-desc {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 12rpx;
  line-height: 1.6;
  max-width: 480rpx;
}

/* 概况 */
.info-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 26rpx;
  color: var(--text-weak);
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.info-value.link {
  color: var(--ink);
  font-weight: 600;
}

/* 功能入口 */
.func-grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 12rpx 0;
}

.func-item {
  width: 20%;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.func-emoji {
  font-size: 40rpx;
  line-height: 1.2;
}

.func-name {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

/* 视图切换 */
.view-toggle {
  display: flex;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  overflow: hidden;
}

.view-btn {
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-weak);
}

.view-btn.active {
  background: var(--ink);
  color: #FFFFFF;
}

/* 活动 */
.act-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.act-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.act-row:first-child {
  padding-top: 0;
}

.act-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.act-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.act-meta {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 8rpx;
}

/* 地图占位 */
.map-box {
  text-align: center;
  padding: 60rpx 32rpx;
}

.map-pin {
  font-size: 72rpx;
  line-height: 1.2;
}

.map-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-top: 12rpx;
}

.map-addr {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.map-tip {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 20rpx;
}

/* 附近服务 */
.near-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.near-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.near-row:first-child {
  padding-top: 0;
}

.near-emoji {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.near-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.near-desc {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}
