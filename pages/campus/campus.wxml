<!-- pages/campus/campus.wxml -->
<view class="page">

  <!-- 顶部校区插画区 -->
  <view class="campus-hero">
    <view class="hero-deco">🏫</view>
    <picker mode="selector" range="{{campusList}}" bindchange="onCampusChange">
      <view class="hero-campus">
        <text>{{campus}}</text>
        <text class="hero-arrow">▾</text>
      </view>
    </picker>
    <view class="hero-desc">{{info.desc}}</view>
  </view>

  <!-- 校区概况 -->
  <view class="section-title">校区概况</view>
  <view class="card">
    <view class="info-row">
      <text class="info-label">地址</text>
      <text class="info-value">{{info.address}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">开放时间</text>
      <text class="info-value">{{info.openTime}}</text>
    </view>
    <view class="info-row" bindtap="onCall">
      <text class="info-label">联系方式</text>
      <text class="info-value link">{{info.phone}} ›</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="section-title">常用功能</view>
  <view class="func-grid">
    <view
      class="func-item"
      wx:for="{{funcEntries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onFuncTap"
    >
      <view class="func-emoji">{{item.emoji}}</view>
      <view class="func-name">{{item.name}}</view>
    </view>
  </view>

  <!-- 校区动态 / 公告 -->
  <view class="section-title">
    <text>校区动态</text>
    <view class="view-toggle">
      <view
        class="view-btn {{viewMode === 'list' ? 'active' : ''}}"
        data-mode="list"
        bindtap="onViewToggle"
      >列表</view>
      <view
        class="view-btn {{viewMode === 'map' ? 'active' : ''}}"
        data-mode="map"
        bindtap="onViewToggle"
      >地图</view>
    </view>
  </view>

  <block wx:if="{{viewMode === 'list'}}">
    <view class="card" wx:if="{{activities.length}}">
      <view class="act-row" wx:for="{{activities}}" wx:key="_id">
        <view class="act-title">{{item.title}}</view>
        <view class="act-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
        <view class="act-meta">{{item.timeText}} · {{item.place}}</view>
      </view>
    </view>
    <view class="card empty" wx:else>
      <text class="empty-icon">📣</text>
      这个校区还没有动态
    </view>
  </block>

  <block wx:else>
    <view class="card map-box">
      <view class="map-pin">📍</view>
      <view class="map-title">{{campus}}</view>
      <view class="map-addr">{{info.address}}</view>
      <view class="map-tip">地图功能即将上线，先看地址吧</view>
    </view>
  </block>

  <!-- 附近服务 -->
  <view class="section-title">附近服务</view>
  <view class="card">
    <view class="near-row" wx:for="{{nearby}}" wx:key="name">
      <view class="near-emoji">{{item.emoji}}</view>
      <view class="near-body">
        <view class="near-name">{{item.name}}</view>
        <view class="near-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

</view>
