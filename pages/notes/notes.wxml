<!-- pages/notes/notes.wxml -->
<view class="page">

  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索笔记标题或内容"
      placeholder-class="search-ph"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
  </view>

  <!-- 标签筛选 + 视图切换 -->
  <view class="filter-row">
    <scroll-view class="tag-scroll" scroll-x="true" enable-flex="true">
      <view
        class="tag-chip {{activeTag === item ? 'active' : ''}}"
        wx:for="{{tags}}"
        wx:key="*this"
        data-tag="{{item}}"
        bindtap="onTagTap"
      >{{item}}</view>
    </scroll-view>
    <view class="view-toggle">
      <view
        class="view-btn {{viewMode === 'card' ? 'active' : ''}}"
        data-mode="card"
        bindtap="onViewToggle"
      >▦</view>
      <view
        class="view-btn {{viewMode === 'list' ? 'active' : ''}}"
        data-mode="list"
        bindtap="onViewToggle"
      >☰</view>
    </view>
  </view>

  <!-- 卡片视图 -->
  <block wx:if="{{viewMode === 'card'}}">
    <view
      class="note-card"
      wx:for="{{notes}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="openNote"
    >
      <view class="note-card-head">
        <view class="note-card-title">{{item.title}}</view>
        <view class="note-badge" wx:if="{{!item.isPublic}}">私密</view>
      </view>
      <view class="note-card-summary ellipsis-3">{{item.summary}}</view>
      <view class="note-card-tags">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>
      <view class="note-card-foot">
        <text class="foot-item">{{item.campus || '未选校区'}}</text>
        <text class="foot-item">{{item.authorName || '同学'}}</text>
        <text class="foot-item">{{item.dateText}}</text>
      </view>
    </view>
  </block>

  <!-- 列表视图 -->
  <block wx:else>
    <view
      class="note-list-row"
      wx:for="{{notes}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="openNote"
    >
      <view class="list-main">
        <view class="list-title">{{item.title}}</view>
        <view class="list-meta">{{item.campus || '未选校区'}} · {{item.dateText}}</view>
      </view>
      <view class="list-arrow">›</view>
    </view>
  </block>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!notes.length}}">
    <text class="empty-icon">📝</text>
    <view>记录第一条校园笔记</view>
    <view class="empty-btn" bindtap="goCreate">去写笔记</view>
  </view>

  <!-- 加载状态 -->
  <view class="load-tip" wx:if="{{notes.length}}">
    <text wx:if="{{loadingMore}}">加载中…</text>
    <text wx:elif="{{!hasMore}}">已经到底啦</text>
    <text wx:else>上拉加载更多</text>
  </view>

  <!-- 底部悬浮写笔记 -->
  <view class="fab" bindtap="goCreate">＋</view>

</view>
