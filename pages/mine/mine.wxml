<!-- pages/mine/mine.wxml -->
<view class="page">

  <!-- 个人信息 -->
  <view class="profile">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-body">
      <view class="profile-name">{{nickName}}</view>
      <view class="profile-campus">{{campus}}</view>
    </view>
    <view class="profile-edit" bindtap="editNickName">编辑</view>
  </view>

  <!-- 数据统计 -->
  <view class="stat-card">
    <view class="stat-item">
      <view class="stat-num">{{streak}}</view>
      <view class="stat-label">连续打卡</view>
    </view>
    <view class="stat-line"></view>
    <view class="stat-item">
      <view class="stat-num">{{noteCount}}</view>
      <view class="stat-label">笔记数</view>
    </view>
    <view class="stat-line"></view>
    <view class="stat-item">
      <view class="stat-num">{{checkinCount}}</view>
      <view class="stat-label">打卡天数</view>
    </view>
  </view>

  <!-- 我的功能 -->
  <view class="section-title">我的</view>
  <view class="card menu-card">
    <view
      class="menu-row"
      wx:for="{{menuList}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onMenuTap"
    >
      <text class="menu-emoji">{{item.emoji}}</text>
      <text class="menu-name">{{item.name}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="section-title">设置</view>
  <view class="card menu-card">
    <view
      class="menu-row"
      wx:for="{{settingList}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSettingTap"
    >
      <text class="menu-emoji">{{item.emoji}}</text>
      <text class="menu-name">{{item.name}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer-tip">校园笔记 · 记录每一天</view>

</view>
