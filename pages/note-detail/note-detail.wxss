/* pages/note-detail/note-detail.wxss */

.page {
  padding-bottom: 200rpx;
}

.ph {
  color: var(--text-weak);
}

/* 自动保存提示 */
.auto-tip {
  position: fixed;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(31, 58, 95, 0.9);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  z-index: 30;
}

/* 编辑区 */
.title-input {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  padding: 16rpx 0;
  line-height: 1.4;
}

.content-input {
  width: 100%;
  height: 520rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text);
  padding: 8rpx 0;
  box-sizing: border-box;
}

/* 标签 */
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
}

.tag-chip {
  padding: 10rpx 26rpx;
  margin: 0 14rpx 16rpx 0;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--text-sub);
  font-size: 24rpx;
}

.tag-chip.active {
  background: var(--ink);
  border-color: var(--ink);
  color: #FFFFFF;
  font-weight: 600;
}

/* 设置行 */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.setting-label {
  font-size: 28rpx;
  color: var(--text);
}

.setting-value {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
}

/* 底部工具栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-top: 1rpx solid var(--line);
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 20;
}

.tool-group {
  display: flex;
  align-items: center;
}

.tool-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: #F1EEE7;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}

.tool-btn.on {
  background: var(--ink);
  color: #FFFFFF;
}

.save-btn {
  background: var(--ink);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 52rpx;
  border-radius: 999rpx;
}

/* 详情模式 */
.detail-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.detail-meta {
  font-size: 24rpx;
  color: var(--text-weak);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.detail-meta .dot {
  margin: 0 10rpx;
}

.privacy-tag {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.detail-tags {
  margin-top: 20rpx;
}

.detail-content {
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--text);
  white-space: pre-wrap;
  word-break: break-all;
}

/* 图片网格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.img-item {
  width: 210rpx;
  height: 210rpx;
  border-radius: 16rpx;
  margin: 0 16rpx 16rpx 0;
  background: #F1EEE7;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-top: 1rpx solid var(--line);
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  z-index: 20;
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 44rpx;
}

.action-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.share-btn {
  margin-left: auto;
  background: var(--ink);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 44rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
}

.share-btn::after {
  border: none;
}
